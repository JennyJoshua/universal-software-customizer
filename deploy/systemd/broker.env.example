# Copy to /etc/usc-runner/broker.env; set numeric IDs before use.
# Keep this file root:root mode 0640. These values are configuration, not secrets.
# USC_CLIENT_GID=<numeric GID of usc-clients>
# USC_CONTROL_UID=<numeric UID of usc-control>
# Absolute path to the root/service-owned Ed25519 public key (never the private key).
# USC_APPROVAL_PUBLIC_KEY=/var/lib/usc-runner/approval-public.pem
